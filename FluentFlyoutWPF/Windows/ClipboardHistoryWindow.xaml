<controls:MicaWindow x:Class="FluentFlyoutWPF.Windows.ClipboardHistoryWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
      mc:Ignorable="d"
      Title="{DynamicResource ClipboardHistoryWindowTitle}"
      Width="360" Height="430"
      ResizeMode="NoResize"
      WindowStyle="None"
      ShowInTaskbar="False"
      WindowStartupLocation="Manual"
      ChangeTitleColorWhenInactive="False"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextFormattingMode="Ideal"
      FontFamily="{Binding FontFamily}"
      FlowDirection="{Binding FlowDirection}"
      KeyDown="Window_KeyDown"
      Deactivated="Window_Deactivated">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="4,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="ClipboardClock24" FontSize="20" Margin="0,0,9,0" />
                <TextBlock Text="{DynamicResource ClipboardHistoryWindowTitle}"
                           FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="ClearHistoryButton"
                           Appearance="Transparent"
                           Padding="8,6"
                           Margin="0,0,3,0"
                           Visibility="Collapsed"
                           ToolTip="{DynamicResource ClipboardHistoryClearText}"
                           Click="ClearHistoryButton_Click">
                    <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                </ui:Button>
                <ui:Button Appearance="Transparent"
                           Padding="7"
                           Click="CloseButton_Click">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                </ui:Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock x:Name="StatusText"
                       Text="{DynamicResource ClipboardHistoryLoadingText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="280"
                       Opacity="0.65" />

            <ui:PassiveScrollViewer x:Name="HistoryScrollViewer"
                                    VerticalScrollBarVisibility="Auto"
                                    Visibility="Collapsed">
                <ItemsControl x:Name="HistoryItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,7">
                                <ui:Button Appearance="Secondary"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Stretch"
                                           Padding="12,10,48,10"
                                           Tag="{Binding}"
                                           Click="HistoryItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Margin="0,1,11,0" VerticalAlignment="Top">
                                            <Border Width="76" Height="56"
                                                    CornerRadius="5"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    Visibility="{Binding Image, Converter={StaticResource NullToCollapsedConverter}}">
                                                <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                            </Border>
                                            <ui:SymbolIcon Symbol="Clipboard24"
                                                           FontSize="18"
                                                           Visibility="{Binding Image, Converter={StaticResource NullToVisibleConverter}}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Preview}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="58" />
                                            <TextBlock Text="{Binding Timestamp}"
                                                       FontSize="11"
                                                       Margin="0,5,0,0"
                                                       Opacity="0.5" />
                                        </StackPanel>
                                    </Grid>
                                </ui:Button>
                                <ui:Button HorizontalAlignment="Right"
                                           Appearance="Transparent"
                                           Padding="7"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Tag="{Binding}"
                                           ToolTip="{DynamicResource ClipboardHistoryDeleteText}"
                                           Click="DeleteHistoryItem_Click">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="15" />
                                </ui:Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:PassiveScrollViewer>
        </Grid>
    </Grid>
</controls:MicaWindow>
