<Window x:Class="FluentFlyout.Windows.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FluentFlyout.Windows"
        xmlns:controls="clr-namespace:FluentFlyout.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="TaskbarWindow" Height="40" Width="100"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal"
        FontFamily="{Binding FontFamily}"
        FlowDirection="{Binding FlowDirection}"
        Loaded="Window_Loaded" Visibility="Collapsed" d:Visibility="Visible"
        xmlns:viewModels="clr-namespace:FluentFlyoutWPF.ViewModels"
		d:DataContext="{d:DesignInstance viewModels:UserSettings}">
    <Canvas Name="WidgetCanvas" Background="Transparent">
		<controls:TaskbarVisualizerControl x:Name="TaskbarVisualizer" Margin="0,1,0,0" />
        <StackPanel x:Name="QuickActionsPanel" Orientation="Horizontal">
            <ui:Button x:Name="MixerButton"
                       Width="36" Height="36" Padding="0" Margin="0,0,5,0"
                       Appearance="Transparent"
                       Visibility="{Binding TaskbarMixerButtonEnabled, Converter={StaticResource BoolToVisibleCollapsedConverter}}"
                       ToolTip="{DynamicResource TaskbarMixerButtonTitle}"
                       Click="MixerButton_Click">
                <ui:SymbolIcon Symbol="SpeakerSettings24" FontSize="18" />
            </ui:Button>
            <ui:Button x:Name="ClipboardButton"
                       Width="36" Height="36" Padding="0"
                       Appearance="Transparent"
                       Visibility="{Binding TaskbarClipboardButtonEnabled, Converter={StaticResource BoolToVisibleCollapsedConverter}}"
                       ToolTip="{DynamicResource TaskbarClipboardButtonTitle}"
                       Click="ClipboardButton_Click">
                <ui:SymbolIcon Symbol="ClipboardClock24" FontSize="18" />
            </ui:Button>
        </StackPanel>
        <controls:TaskbarWidgetControl x:Name="Widget" />
    </Canvas>
</Window>
